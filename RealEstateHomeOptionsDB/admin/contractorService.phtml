function getContractorList(){
        
        global $db;

        //Prepare associated array with the age
        $content = array();

        $sql_Contractor = "SELECT ContractorID, ContractorName FROM Contractor 
        WHERE ContractorName != ''
        ORDER BY ContractorName";

        $result_Contractor = mysql_query($sql_Contractor,$db) or die("Error : $sql_Contractor<br>" . mysql_error());        
        while ($row = mysql_fetch_array($result_Contractor)) {
            $resultRow                      = array();
            $resultRow['ContractorID']      = $row['ContractorID'];
            $resultRow['ContractorName']    = $row['ContractorName'] ?? 0;


            array_push($content, $resultRow);
        }

        echo json_encode($content, JSON_NUMERIC_CHECK);

        
} // getContractorList

